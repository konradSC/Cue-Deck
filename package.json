{
  "name": "cue-deck",
  "version": "0.1.0",
  "description": "Game-day music control for the Spotify desktop app, built on Spicetify",
  "private": true,
  "scripts": {
    "build": "spicetify-creator",
    "build-local": "spicetify-creator --out=dist --minify",
    "watch": "spicetify-creator --watch",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "spicetify-creator": "^1.0.17",
    "typescript": "^7.0.2"
  }
}
